# Пример настроек. На сервере файл .env создаёт scripts/install.sh.
DOMAIN=example.ru
APP_URL=https://example.ru
OWNER_EMAIL=you@example.ru
DB_PASSWORD=сгенерируйте-длинный-пароль
AUTH_SECRET=сгенерируйте-строку-из-64-символов
# Почта для кодов входа. Пусто — коды пишутся в журнал: docker compose logs app
# Пример для Яндекс 360: smtps://no-reply%40example.ru:ПАРОЛЬ_ПРИЛОЖЕНИЯ@smtp.yandex.ru:465
SMTP_URL=
MAIL_FROM=ReQuest <no-reply@example.ru>
